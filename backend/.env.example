APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Storage & Retrieval Paths
# In Docker (production): set these via environment variables in render.yaml:
#   BM25_INDEX_PATH=/app/data/index/bm25.pkl
#   CHROMA_PATH=/app/data/index/chroma
# In local dev: leave unset — config.py auto-resolves from repository root.
# CHROMA_PATH=
# BM25_INDEX_PATH=
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM (Ollama / LLaMA 3.1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_CONCURRENCY_LIMIT=2
LLM_TIMEOUT_SECONDS=120

# Supabase (Application DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional Integration
N8N_WEBHOOK_URL=
